#%PAM-1.0
# swaylock: heslo NEBO otisk prstu
#   heslo + Enter -> ověří se heslo (system-auth), čtečka se nezapíná, nic se nečeká
#   prázdný Enter -> zapne se čtečka, přilož prst (3 pokusy, max 10 s)
# Když pw-empty chybí nebo selže, spadne to bezpečně na ověření heslem.
auth  [success=ignore default=1]  pam_exec.so quiet quiet_log expose_authtok /usr/local/lib/swaylock/pw-empty
auth  [success=done default=die]  pam_fprintd.so max-tries=3 timeout=10
auth  include                     system-auth
