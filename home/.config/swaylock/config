# swaylock — barvy z noctalie (Material You podle tapety)
# Tapetu jako pozadí přidává ~/.local/bin/lock-screen (-i), tohle je záloha bez ní.
#
# Odemknutí:  stiskni jen Enter a přilož prst ke čtečce   NEBO   napiš heslo + Enter.
# (prázdný Enter spouští otisk přes /etc/pam.d/swaylock; když v poli něco je,
#  třeba znak z probouzení displeje, smaž ho Escapem a pak Enter + prst)

color=000000
scaling=fill
font=JetBrainsMono Nerd Font
font-size=22

indicator-idle-visible
indicator-radius=110
indicator-thickness=9
show-failed-attempts
show-keyboard-layout

inside-color=000000aa
inside-clear-color=000000aa
inside-caps-lock-color=000000aa
inside-ver-color=a1c9fe33
inside-wrong-color=ffb4ab33

ring-color=a1c9fe
ring-clear-color=b9c8de
ring-caps-lock-color=e8b5ef
ring-ver-color=a1c9fe
ring-wrong-color=ffb4ab

key-hl-color=e8b5ef
bs-hl-color=ffb4ab
caps-lock-key-hl-color=e8b5ef
caps-lock-bs-hl-color=ffb4ab

line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000

text-color=e2e2e6
text-clear-color=e2e2e6
text-caps-lock-color=e8b5ef
text-ver-color=e2e2e6
text-wrong-color=ffb4ab

layout-bg-color=000000aa
layout-border-color=00000000
layout-text-color=e2e2e6
